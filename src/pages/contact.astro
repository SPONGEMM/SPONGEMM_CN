---
import Header from "../components/site/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import GitHubIcon from "../components/icons/GitHubIcon.astro";
import MailIcon from "../components/icons/MailIcon.astro";
import ArrowOutIcon from "../components/icons/ArrowOutIcon.astro";
import QrDialog from "../components/contact/QrDialog.astro";
import { getSiteUrl } from "../lib/site";

type CardBase = { num: string; tag: string; title: string; subtitle: string };
type InstitutionCard = CardBase & {
  kind: "institution";
  addressLines: string[];
  action: { label: string; href: string };
};
type QqCard = CardBase & {
  kind: "qq";
  image: string;
  imageAlt: string;
};
type GithubCard = CardBase & {
  kind: "github";
  repos: { label: string; href: string; note: string }[];
};
type ContactCard = InstitutionCard | QqCard | GithubCard;

const cards: ContactCard[] = [
  {
    kind: "institution",
    num: "01",
    tag: "北京",
    title: "北京大学",
    subtitle: "化学与分子工程学院",
    addressLines: ["北京市海淀区成府路 202 号", "邮编 100871"],
    action: { label: "yijiexia@pku.edu.cn", href: "mailto:yijiexia@pku.edu.cn" }
  },
  {
    kind: "institution",
    num: "02",
    tag: "杭州",
    title: "西湖大学",
    subtitle: "理学院",
    addressLines: ["浙江省杭州市西湖区墩余路 600 号 · 云谷校区", "邮编 310030"],
    action: { label: "xiayijie@westlake.edu.cn", href: "mailto:xiayijie@westlake.edu.cn" }
  },
  {
    kind: "qq",
    num: "03",
    tag: "QQ 群",
    title: "SPONGE 用户群",
    subtitle: "扫码加入",
    image: "/assets/contact/qq.jpg",
    imageAlt: "SPONGE 用户 QQ 群二维码"
  },
  {
    kind: "github",
    num: "04",
    tag: "源代码",
    title: "GitHub",
    subtitle: "项目相关仓库",
    repos: [
      { label: "spongemm/SPONGE", href: "https://github.com/spongemm/SPONGE", note: "程序源码" },
      { label: "spongemm/spongemm_cn", href: "https://github.com/spongemm/spongemm_cn", note: "官网源码" },
      { label: "spongemm", href: "https://github.com/spongemm", note: "组织仓库" }
    ]
  }
];

const pageTitle = "SPONGEMM | 联系我们";
const pageDescription =
  "SPONGE 分子模拟软件团队联系方式：北京大学化学与分子工程学院、西湖大学理学院办公地点，开发者邮箱、QQ 用户群与 GitHub 源码与官网仓库。";
const siteUrl = getSiteUrl(Astro.site);

const contactJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: pageTitle,
    description: pageDescription,
    url: `${siteUrl}/contact`,
    inLanguage: "zh-CN",
    isPartOf: { "@type": "WebSite", name: "SPONGEMM", url: siteUrl }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "SPONGEMM",
    url: siteUrl,
    parentOrganization: {
      "@type": "CollegeOrUniversity",
      name: "北京大学",
      url: "https://www.pku.edu.cn/"
    },
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "Academic inquiry (Peking University)",
        email: "yijiexia@pku.edu.cn",
        areaServed: "CN",
        availableLanguage: ["zh-CN", "en"]
      },
      {
        "@type": "ContactPoint",
        contactType: "Academic inquiry (Westlake University)",
        email: "xiayijie@westlake.edu.cn",
        areaServed: "CN",
        availableLanguage: ["zh-CN", "en"]
      }
    ],
    location: [
      {
        "@type": "Place",
        name: "北京大学化学与分子工程学院",
        address: {
          "@type": "PostalAddress",
          streetAddress: "成府路 202 号",
          postalCode: "100871",
          addressLocality: "海淀区",
          addressRegion: "北京市",
          addressCountry: "CN"
        }
      },
      {
        "@type": "Place",
        name: "西湖大学理学院",
        address: {
          "@type": "PostalAddress",
          streetAddress: "墩余路 600 号 · 云谷校区",
          postalCode: "310030",
          addressLocality: "西湖区",
          addressRegion: "杭州市",
          addressCountry: "CN"
        }
      }
    ],
    sameAs: [
      "https://github.com/spongemm",
      "https://github.com/spongemm/SPONGE",
      "https://github.com/spongemm/spongemm_cn"
    ]
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/contact"
  alternateLocales={[
    { hreflang: "zh-CN", path: "/contact" },
    { hreflang: "en", path: "/en/contact" },
    { hreflang: "x-default", path: "/contact" }
  ]}
  ogImage="/assets/home/sponge-logo-notext.png"
  jsonLd={contactJsonLd}
>
  <Header />
  <main class="contact-page">
    <div class="contact-bg" aria-hidden="true"></div>

    <section class="contact-hero container">
      <p class="eyebrow">联络</p>
      <h1 class="contact-title">
        <span class="contact-title-zh">想聊聊吗<span class="contact-title-period">？</span></span>
      </h1>
      <p class="contact-lede">
        SPONGE 由北京大学高毅勤课题组与合作团队共同开发与维护。
      </p>
    </section>

    <section class="contact-grid container">
      {cards.map((c) => (
        <article class="c-card">
          <header class="c-head">
            <span class="c-num">{c.num}</span>
            <span class="c-tag">{c.tag}</span>
          </header>

          <div class="c-body">
            <h2 class="c-title">{c.title}</h2>
            <p class="c-sub">{c.subtitle}</p>
          </div>

          {c.kind === "institution" && (
            <>
              <div class="c-address">
                {c.addressLines.map((line) => <p>{line}</p>)}
              </div>
              <a class="c-pill" href={c.action.href}>
                <MailIcon />
                <span>{c.action.label}</span>
              </a>
            </>
          )}

          {c.kind === "qq" && (
            <QrDialog src={c.image} alt={c.imageAlt} closeLabel="关闭" />
          )}

          {c.kind === "github" && (
            <div class="c-repos">
              {c.repos.map((r) => (
                <a class="c-repo-row" href={r.href} target="_blank" rel="noreferrer">
                  <span class="c-repo-icon" aria-hidden="true">
                    <GitHubIcon size={20} />
                  </span>
                  <span class="c-repo-text">
                    <span class="c-repo-name">{r.label}</span>
                    <span class="c-repo-note">{r.note}</span>
                  </span>
                  <ArrowOutIcon size={16} />
                </a>
              ))}
            </div>
          )}
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .contact-page {
    position: relative;
    padding: 96px 0 160px;
    overflow: hidden;
  }
  .contact-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(60% 50% at 80% 0%, rgba(78, 161, 255, 0.18), transparent 70%),
      radial-gradient(50% 40% at 0% 30%, rgba(29, 105, 181, 0.10), transparent 70%);
  }
  .contact-page > * {
    position: relative;
    z-index: 1;
  }

  .contact-hero {
    padding-bottom: 64px;
  }
  .contact-title {
    margin: 24px 0 0;
    display: grid;
    gap: 4px;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-weight: 600;
    font-size: clamp(2.6rem, 8vw, 6.4rem);
    line-height: 0.96;
    letter-spacing: -0.035em;
  }
  .contact-title-zh {
    color: var(--text);
  }
  .contact-title-period {
    color: var(--accent);
  }
  .contact-lede {
    margin: 28px 0 0;
    max-width: 580px;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--muted);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .c-card {
    position: relative;
    padding: 36px 36px 30px;
    border-radius: 28px;
    background: var(--surface-strong);
    border: 1px solid var(--line);
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 22px;
    overflow: hidden;
    transition: border-color 220ms ease, transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 280ms ease;
  }
  .c-card::before {
    content: "";
    position: absolute;
    top: -120px;
    right: -120px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(78, 161, 255, 0.12), transparent 70%);
    pointer-events: none;
    transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c-card:hover {
    border-color: rgba(29, 105, 181, 0.35);
    transform: translateY(-4px);
    box-shadow: 0 30px 60px rgba(17, 74, 133, 0.08);
  }
  .c-card:hover::before {
    transform: translate(-30px, 30px);
  }

  .c-head {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--primary);
  }
  .c-num {
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    font-weight: 600;
  }
  .c-tag {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .c-tag::before {
    content: "";
    display: inline-block;
    width: 18px;
    height: 1px;
    margin-right: 12px;
    vertical-align: middle;
    background: rgba(29, 105, 181, 0.4);
  }

  .c-body {
    display: grid;
    gap: 6px;
  }
  .c-title {
    margin: 0;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-weight: 600;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .c-sub {
    margin: 0;
    color: var(--text);
    font-size: 1.05rem;
  }

  .c-address {
    align-self: end;
    color: var(--muted);
    line-height: 1.7;
    font-size: 0.95rem;
  }
  .c-address p {
    margin: 0;
  }
  .c-address p + p {
    margin-top: 4px;
  }

  .c-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-radius: 999px;
    background: rgba(29, 105, 181, 0.08);
    color: var(--primary-strong);
    font-family: "Space Grotesk", "Inter", monospace;
    font-size: 0.96rem;
    width: fit-content;
    justify-self: start;
    transition: background 220ms ease, transform 220ms ease;
  }
  .c-pill svg {
    flex-shrink: 0;
    transition: transform 220ms ease;
  }
  .c-pill:hover {
    background: rgba(29, 105, 181, 0.16);
  }
  .c-pill:hover svg {
    transform: translate(2px, -2px);
  }

  .c-repos {
    grid-row: 3 / 5;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
  }
  .c-repo-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.6);
    color: var(--text);
    transition: border-color 220ms ease, background 220ms ease, transform 220ms ease;
  }
  .c-repo-row:hover {
    border-color: rgba(29, 105, 181, 0.4);
    background: rgba(29, 105, 181, 0.04);
  }
  .c-repo-icon {
    color: var(--primary-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .c-repo-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .c-repo-name {
    font-family: "Space Grotesk", "Inter", monospace;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--primary-strong);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .c-repo-note {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .c-repo-row > svg {
    color: var(--muted);
    transition: transform 220ms ease, color 220ms ease;
  }
  .c-repo-row:hover > svg {
    color: var(--primary);
    transform: translate(2px, -2px);
  }

  @media (max-width: 880px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .contact-page {
      padding: 56px 0 96px;
    }
    .c-card {
      padding: 28px 26px 26px;
    }
  }
</style>
