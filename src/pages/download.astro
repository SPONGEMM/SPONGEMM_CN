---
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import LegacyDocsLayout from "../components/legacy/LegacyDocsLayout.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadLegacyMarkdown } from "../lib/legacy-markdown";

const page = await loadLegacyMarkdown("下载");

if (!page) {
  throw new Error("Missing legacy download overview page");
}

const Content = page.module.default;
---

<BaseLayout title="SPONGEMM | 下载">
  <Header />
  <main>
    <LegacyDocsLayout section="download" currentPath="/download" title={page.title}>
      <div class="legacy-markdown-body">
        <Content />
      </div>
    </LegacyDocsLayout>
  </main>
  <Footer />
</BaseLayout>
