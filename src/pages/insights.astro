---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/site/Header.astro";

const entries = (await getCollection("insights"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pageTitle = "SPONGEMM | 观点洞见";
const pageDescription =
  "SPONGE 观点洞见栏目，记录与分子模拟、分子建模、计算化学方法相关的观点、观察与经验，欢迎以 GitHub PR 的方式投稿。";

const dateFmt = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric"
});

const siteUrl = (Astro.site?.toString() ?? "https://spongemm.cn/").replace(/\/$/, "");
const blogJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "SPONGEMM 观点洞见",
    description: pageDescription,
    url: `${siteUrl}/insights`,
    inLanguage: "zh-CN",
    isPartOf: { "@type": "WebSite", name: "SPONGEMM", url: siteUrl }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "SPONGEMM 观点洞见文章列表",
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: entries.length,
    itemListElement: entries.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${siteUrl}/insights/${entry.slug}`,
      name: entry.data.title
    }))
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/insights"
  alternateLocales={[
    { hreflang: "zh-CN", path: "/insights" },
    { hreflang: "en", path: "/en/insights" },
    { hreflang: "x-default", path: "/insights" }
  ]}
  jsonLd={blogJsonLd}
>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title="SPONGEMM 观点洞见 RSS"
    href="/rss.xml"
  />
  <Header />
  <main class="insights-page">
    <div class="insights-shell">
      <p class="insights-eyebrow">观点洞见</p>

      {entries.length === 0 ? (
        <p class="insights-empty">暂无文章。</p>
      ) : (
        <ul class="insights-list">
          {entries.map((entry) => (
            <li>
              <a class="insights-card" href={`/insights/${entry.slug}`}>
                <h2 class="insights-card-title">{entry.data.title}</h2>
                <p class="insights-card-desc">{entry.data.description}</p>
                <div class="insights-card-foot">
                  <div class="insights-card-author">
                    {entry.data.avatar ? (
                      <img class="insights-card-avatar" src={entry.data.avatar} alt={entry.data.author} width="28" height="28" loading="lazy" />
                    ) : (
                      <span class="insights-card-avatar insights-card-avatar--fallback" aria-hidden="true">
                        {entry.data.author.slice(0, 1)}
                      </span>
                    )}
                    <span>{entry.data.author}</span>
                  </div>
                  <time class="insights-card-date" datetime={entry.data.date.toISOString()}>
                    {dateFmt.format(entry.data.date)}
                  </time>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .insights-page {
    padding: 80px 0 160px;
  }
  .insights-shell {
    width: min(calc(100% - 48px), 880px);
    margin: 0 auto;
  }

  .insights-eyebrow {
    margin: 0 0 32px;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--primary);
    font-weight: 600;
  }

  .insights-empty {
    padding: 48px 0;
    color: var(--muted);
  }

  .insights-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }

  .insights-card {
    display: block;
    padding: 28px 32px 24px;
    border-radius: 20px;
    background: var(--surface-strong);
    border: 1px solid var(--line);
    color: var(--text);
    transition: border-color 220ms ease,
                transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 280ms ease;
  }
  .insights-card:hover {
    border-color: rgba(29, 105, 181, 0.4);
    transform: translateY(-3px);
    box-shadow: 0 20px 50px rgba(17, 74, 133, 0.06);
  }
  .insights-card-date {
    font-family: "Space Grotesk", "Inter", monospace;
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .insights-card-title {
    margin: 0 0 10px;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-weight: 600;
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .insights-card-desc {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }
  .insights-card-foot {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .insights-card-author {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 0.94rem;
    font-weight: 500;
  }
  .insights-card-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
    flex-shrink: 0;
  }
  .insights-card-avatar--fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(29, 105, 181, 0.12);
    color: var(--primary-strong);
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-weight: 600;
    font-size: 0.82rem;
  }

  @media (max-width: 720px) {
    .insights-page {
      padding: 56px 0 96px;
    }
    .insights-card {
      padding: 22px 22px 20px;
      border-radius: 18px;
    }
  }
</style>
