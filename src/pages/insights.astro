---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/site/Header.astro";
import InsightCard from "../components/insights/InsightCard.astro";
import { getSiteUrl } from "../lib/site";

const entries = (await getCollection("insights"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pageTitle = "SPONGEMM | 观点洞见";
const pageDescription =
  "SPONGE 观点洞见栏目，记录与分子模拟、分子建模、计算化学方法相关的观点、观察与经验，欢迎以 GitHub PR 的方式投稿。";

const dateFmt = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric"
});

const siteUrl = getSiteUrl(Astro.site);
const blogJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "SPONGEMM 观点洞见",
    description: pageDescription,
    url: `${siteUrl}/insights`,
    inLanguage: "zh-CN",
    isPartOf: { "@type": "WebSite", name: "SPONGEMM", url: siteUrl }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "SPONGEMM 观点洞见文章列表",
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: entries.length,
    itemListElement: entries.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${siteUrl}/insights/${entry.id}`,
      name: entry.data.title
    }))
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/insights"
  alternateLocales={[
    { hreflang: "zh-CN", path: "/insights" },
    { hreflang: "en", path: "/en/insights" },
    { hreflang: "x-default", path: "/insights" }
  ]}
  jsonLd={blogJsonLd}
>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title="SPONGEMM 观点洞见 RSS"
    href="/rss.xml"
  />
  <Header />
  <main class="insights-page">
    <div class="insights-shell">
      <p class="eyebrow">观点洞见</p>

      {entries.length === 0 ? (
        <p class="insights-empty">暂无文章。</p>
      ) : (
        <ul class="insights-list">
          {entries.map((entry) => (
            <li>
              <InsightCard entry={entry} hrefPrefix="/insights" dateFmt={dateFmt} />
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .insights-page {
    padding: 80px 0 160px;
  }
  .insights-shell {
    width: min(calc(100% - 48px), 880px);
    margin: 0 auto;
  }
  .insights-shell .eyebrow {
    margin-bottom: 32px;
  }
  .insights-empty {
    padding: 48px 0;
    color: var(--muted);
  }
  .insights-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }

  @media (max-width: 720px) {
    .insights-page {
      padding: 56px 0 96px;
    }
  }
</style>
