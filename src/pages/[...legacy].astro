---
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import LegacyDocsLayout from "../components/legacy/LegacyDocsLayout.astro";
import { getLegacySection } from "../data/legacy-navigation";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLegacyMarkdownRoutes, loadLegacyMarkdown } from "../lib/legacy-markdown";

export function getStaticPaths() {
  return getLegacyMarkdownRoutes().map((legacy) => ({
    params: { legacy }
  }));
}

const route = Astro.params.legacy?.replace(/\/+$/, "") ?? "";
const page = await loadLegacyMarkdown(route);

if (!page) {
  return Astro.redirect("/docs");
}

const Content = page.module.default;
const section = getLegacySection(route);
---

<BaseLayout title={`SPONGEMM | ${page.title}`}>
  <Header />
  <main>
    <LegacyDocsLayout section={section} currentPath={`/${route}`} title={page.title}>
      <div class="legacy-markdown-body">
        <Content />
      </div>
    </LegacyDocsLayout>
  </main>
  <Footer />
</BaseLayout>
