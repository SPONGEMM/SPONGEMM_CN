---
import BaseLayout from "../layouts/BaseLayout.astro";

const acronymWords = [
  { lead: "S", rest: "imulation" },
  { lead: "P", rest: "ackage" },
  { lead: "O", prefix: "t", rest: "ward" },
  { lead: "N", rest: "ext" },
  { lead: "GE", rest: "neration" }
];

const entryLinks = [
  {
    label: "进入首页",
    href: "/home",
    variant: "primary",
    icon: "M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1v-8.5Z"
  },
  {
    label: "查看文档",
    href: "/docs",
    variant: "outline",
    icon: "M6 4h9l3 3v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm8 0v4h4M8 12h8M8 16h5"
  },
  {
    label: "获取程序",
    href: "/download",
    variant: "ghost",
    icon: "M12 4v11m0 0 4-4m-4 4-4-4M5 19h14"
  }
];
---

<BaseLayout title="SPONGEMM | SPONGE">
  <main class="sponge-deck" data-deck>
    <section class="deck-slide is-active" data-slide="0" aria-label="SPONGE 全称与缩写动画">
      <img class="sponge-intro-mark" src="/background.png" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="deck-slide-body">
        <div class="sponge-intro-stage">
          <div class="sponge-full-name" aria-label="Simulation Package tOward Next GEneration molecular modelling">
            {acronymWords.map((word, index) => (
              <span class="sponge-word" style={`--word-index: ${index}`}>
                {word.prefix && <span class="sponge-prefix">{word.prefix}</span>}
                <span class="sponge-lead">{word.lead}</span>
                <span class="sponge-rest">{word.rest}</span>
              </span>
            ))}
            <span class="sponge-word sponge-tail" style="--word-index: 5">molecular modelling</span>
          </div>

          <h1 class="sponge-acronym">SPONGE</h1>
        </div>

        <nav class="sponge-entry" aria-label="主要入口">
          {entryLinks.map((link, index) => (
            <a
              class={`sponge-entry-link is-${link.variant}`}
              href={link.href}
              style={`--entry-index: ${index}`}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d={link.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{link.label}</span>
            </a>
          ))}
        </nav>
      </div>

      <button type="button" class="sponge-scroll-hint" data-deck-next aria-label="继续向下浏览">
        <span>向下滚动</span>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </section>

    <section class="deck-slide is-future" data-slide="1" aria-label="SPONGE 概览">
      <div class="deck-slide-body deck-overview">
        <p class="deck-eyebrow">What is SPONGE</p>
        <h2 class="deck-title">
          面向下一代分子模拟的<br />高性能、模块化软件包
        </h2>
        <p class="deck-body">
          SPONGE 由北京大学高毅勤课题组开发，提供 GPU 加速的分子动力学模拟、丰富的增强采样方法，以及深度学习势函数与算法的原生集成。
        </p>
        <div class="deck-actions">
          <a class="sponge-entry-link is-primary" href="/home">了解更多</a>
          <a class="sponge-entry-link is-outline" href="/docs">阅读文档</a>
        </div>
      </div>

      <button type="button" class="sponge-scroll-hint up" data-deck-prev aria-label="返回顶部">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>返回</span>
      </button>
    </section>
  </main>
</BaseLayout>

<script>
  const deck = document.querySelector<HTMLElement>("[data-deck]");
  if (deck) {
    const slides = Array.from(deck.querySelectorAll<HTMLElement>(".deck-slide"));
    const INTRO_LOCK_MS = 3800;
    const COOLDOWN_MS = 750;
    let current = 0;
    let ready = false;
    let lastTrigger = 0;
    let touchStartY: number | null = null;

    const unlockReady = () => {
      ready = true;
      deck.classList.add("is-ready");
    };
    window.setTimeout(unlockReady, INTRO_LOCK_MS);

    const goto = (index: number) => {
      if (index < 0 || index >= slides.length || index === current) return;
      const now = performance.now();
      if (now - lastTrigger < COOLDOWN_MS) return;
      lastTrigger = now;
      const direction = index > current ? "down" : "up";
      slides[current].classList.remove("is-active");
      slides[current].classList.add(direction === "down" ? "is-past" : "is-future");
      slides[index].classList.remove("is-past", "is-future");
      slides[index].classList.add("is-active");
      current = index;
    };

    const next = () => goto(current + 1);
    const prev = () => goto(current - 1);

    deck.addEventListener(
      "wheel",
      (event) => {
        if (!ready) {
          event.preventDefault();
          return;
        }
        if (Math.abs(event.deltaY) < 12) return;
        event.preventDefault();
        if (event.deltaY > 0) next();
        else prev();
      },
      { passive: false }
    );

    deck.addEventListener("touchstart", (event) => {
      touchStartY = event.touches[0]?.clientY ?? null;
    }, { passive: true });

    deck.addEventListener("touchend", (event) => {
      if (!ready || touchStartY == null) return;
      const endY = event.changedTouches[0]?.clientY;
      if (endY == null) return;
      const dy = touchStartY - endY;
      if (Math.abs(dy) < 50) return;
      if (dy > 0) next();
      else prev();
      touchStartY = null;
    }, { passive: true });

    window.addEventListener("keydown", (event) => {
      if (!ready) return;
      if (["ArrowDown", "PageDown", " "].includes(event.key)) {
        event.preventDefault();
        next();
      } else if (["ArrowUp", "PageUp"].includes(event.key)) {
        event.preventDefault();
        prev();
      }
    });

    deck.querySelectorAll<HTMLElement>("[data-deck-next]").forEach((el) => {
      el.addEventListener("click", () => next());
    });
    deck.querySelectorAll<HTMLElement>("[data-deck-prev]").forEach((el) => {
      el.addEventListener("click", () => prev());
    });
  }
</script>

<style>
  .sponge-deck {
    position: relative;
    height: 100svh;
    width: 100%;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 18%, rgba(78, 161, 255, 0.14), transparent 32%),
      radial-gradient(circle at 85% 10%, rgba(29, 105, 181, 0.12), transparent 30%),
      var(--bg);
    color: var(--text);
  }

  .deck-slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    align-items: center;
    padding: clamp(24px, 6vw, 72px);
    row-gap: clamp(20px, 3vh, 40px);
    transition:
      opacity 620ms cubic-bezier(0.65, 0, 0.35, 1),
      transform 620ms cubic-bezier(0.65, 0, 0.35, 1);
    opacity: 0;
    transform: translateY(48px);
    pointer-events: none;
  }

  .deck-slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    z-index: 2;
  }

  .deck-slide.is-past {
    opacity: 0;
    transform: translateY(-48px);
    z-index: 1;
  }

  .deck-slide.is-future {
    opacity: 0;
    transform: translateY(48px);
    z-index: 1;
  }

  .deck-slide-body {
    width: min(1180px, 100%);
    display: grid;
    justify-items: center;
    align-content: center;
    row-gap: clamp(36px, 6vh, 72px);
  }

  .sponge-intro-mark {
    position: absolute;
    inset: 50% auto auto 50%;
    width: min(720px, 70vw);
    opacity: 0.08;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .sponge-intro-stage {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    align-items: center;
    justify-items: center;
  }

  .sponge-full-name {
    grid-area: 1 / 1;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(10px, 2vw, 24px);
    align-items: baseline;
    justify-content: center;
    animation: sponge-fullname-out 420ms ease forwards;
    animation-delay: 2.3s;
  }

  .sponge-word {
    display: inline-flex;
    align-items: baseline;
    color: var(--text);
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: clamp(2rem, 5vw, 4.8rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(18px);
    animation: sponge-word-in 520ms ease forwards;
    animation-delay: calc(var(--word-index) * 240ms);
  }

  .sponge-lead {
    color: var(--primary);
  }

  .sponge-tail {
    color: var(--muted);
  }

  .sponge-acronym {
    grid-area: 1 / 1;
    margin: 0;
    color: var(--primary);
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: clamp(5.5rem, 17vw, 15rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: 0.06em;
    text-align: center;
    opacity: 0;
    transform: translateY(12px);
    animation: sponge-acronym-in 600ms ease forwards;
    animation-delay: 2.72s;
  }

  .sponge-entry {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(12px, 2vw, 20px);
    justify-content: center;
    opacity: 0;
    transform: translateY(16px);
    animation: sponge-fade-up 600ms ease forwards;
    animation-delay: 3.35s;
  }

  .sponge-entry-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: clamp(12px, 1.4vw, 16px) clamp(22px, 2.4vw, 30px);
    border-radius: 999px;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .sponge-entry-link svg {
    flex-shrink: 0;
  }

  .sponge-entry-link.is-primary {
    background: var(--primary);
    color: #fff;
    border: 1px solid var(--primary);
    box-shadow: 0 12px 30px rgba(29, 105, 181, 0.28);
  }

  .sponge-entry-link.is-primary:hover {
    background: var(--primary-strong);
    border-color: var(--primary-strong);
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(17, 74, 133, 0.32);
  }

  .sponge-entry-link.is-outline {
    background: var(--surface);
    color: var(--primary);
    border: 1px solid color-mix(in srgb, var(--primary) 45%, transparent);
    backdrop-filter: blur(12px);
  }

  .sponge-entry-link.is-outline:hover {
    background: var(--surface-strong);
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .sponge-entry-link.is-ghost {
    background: transparent;
    color: var(--muted);
    border: 1px dashed color-mix(in srgb, var(--muted) 40%, transparent);
  }

  .sponge-entry-link.is-ghost:hover {
    color: var(--primary);
    border-color: var(--primary);
    border-style: solid;
    transform: translateY(-2px);
  }

  .sponge-scroll-hint {
    --bounce-y: 6px;
    position: absolute;
    bottom: clamp(20px, 3.5vh, 40px);
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 0.82rem;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity 500ms ease, color 180ms ease;
  }

  .sponge-scroll-hint.up {
    --bounce-y: -6px;
    top: clamp(20px, 3.5vh, 40px);
    bottom: auto;
  }

  .sponge-deck.is-ready .sponge-scroll-hint {
    opacity: 1;
    visibility: visible;
    animation: sponge-bounce 1.8s ease-in-out 400ms infinite;
  }

  .sponge-scroll-hint:hover {
    color: var(--primary);
  }

  .sponge-scroll-hint svg {
    display: block;
  }

  .deck-overview {
    text-align: center;
    max-width: 860px;
  }

  .deck-eyebrow {
    margin: 0;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: 0.92rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .deck-title {
    margin: 0;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.2;
    font-weight: 700;
    color: var(--text);
  }

  .deck-body {
    margin: 0;
    max-width: 640px;
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    line-height: 1.7;
    color: var(--muted);
  }

  .deck-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  @keyframes sponge-word-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes sponge-acronym-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes sponge-fullname-out {
    to {
      opacity: 0;
      transform: translateY(-12px);
      visibility: hidden;
    }
  }

  @keyframes sponge-fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes sponge-bounce {
    0%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(var(--bounce-y, 6px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck-slide {
      transition: none;
    }

    .sponge-intro-stage {
      display: flex;
      flex-direction: column;
      gap: 24px;
      justify-content: center;
    }

    .sponge-full-name,
    .sponge-word,
    .sponge-tail,
    .sponge-acronym,
    .sponge-entry,
    .sponge-scroll-hint {
      animation: none;
      opacity: 1;
      transform: none;
      visibility: visible;
    }

    .sponge-full-name,
    .sponge-acronym {
      grid-area: auto;
    }
  }
</style>
