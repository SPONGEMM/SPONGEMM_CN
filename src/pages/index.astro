---
import IntroDeck from "../components/intro/IntroDeck.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "SPONGE | 面向下一代分子科学的分子模拟软件";
const pageDescription =
  "SPONGE 是由北京大学高毅勤课题组开发的分子模拟软件，面向众核 CPU、GPU、NPU 等多种硬件平台提供加速的分子动力学模拟能力。";
const introJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "SPONGEMM",
    url: "https://spongemm.cn/",
    sameAs: ["https://github.com/SPONGEMM/SPONGE"],
    parentOrganization: {
      "@type": "CollegeOrUniversity",
      name: "Peking University"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "SPONGE",
    alternateName: "Simulation Package tOwards Next GEneration molecular modeling",
    applicationCategory: "Scientific software",
    operatingSystem: "Linux, Windows",
    description: pageDescription,
    url: "https://spongemm.cn/",
    codeRepository: "https://github.com/SPONGEMM/SPONGE",
    creator: {
      "@type": "Organization",
      name: "Yi Qin Gao group, Peking University"
    }
  }
];

const entryLinks = [
  {
    label: "进入首页",
    href: "/home",
    variant: "primary",
    icon: "M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1v-8.5Z"
  },
  {
    label: "查看文档",
    href: "/docs",
    variant: "outline",
    icon: "M6 4h9l3 3v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm8 0v4h4M8 12h8M8 16h5"
  },
  {
    label: "程序安装",
    href: "/install",
    variant: "outline",
    icon: "M12 4v11m0 0 4-4m-4 4-4-4M5 19h14"
  },
  {
    label: "观点洞见",
    href: "/insights",
    variant: "outline",
    icon: "M12 5v14M5 12h14M7.5 7.5l9 9M16.5 7.5l-9 9"
  },
  {
    label: "联系我们",
    href: "/contact",
    variant: "outline",
    icon: "M4 7h16v10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7Zm0 0 8 6 8-6"
  }
] as const;

const contextItems = [
  {
    title: "科学问题背景",
    body: "分子结构、动力学和相互作用决定了许多生命、化学和材料过程，但这些过程往往发生在原子尺度和多时间尺度上。"
  },
  {
    title: "分子模拟的角色",
    body: "分子模拟为研究者提供一台计算显微镜，用来连接微观机制、热力学性质和可观测实验现象。"
  },
  {
    title: "现有挑战",
    body: "随着研究体系变大、模拟时间尺度延长和采样问题复杂化，分子模拟软件需要同时适应异构硬件、增强采样方法和 AI 驱动的新计算范式。"
  }
] as const;

const featureSlides = [
  {
    label: "多硬件加速的分子动力学模拟",
    eyebrow: "核心能力",
    title: "多硬件加速的分子动力学模拟",
    body: "SPONGE 面向 CPU、GPU、NPU 和国产硬件平台开展分子动力学模拟加速，兼顾 Windows、Linux 与 macOS 等操作系统上的可移植性和异构计算性能。",
    points: [
      "处理器支持：覆盖 Intel、AMD、Apple 等主流 CPU 以及国产 CPU 平台。",
      "加速器支持：覆盖 NVIDIA、AMD 等 GPU，以及国产 GPU、国产 NPU 等加速器平台。",
      "国产硬件生态：适配华为、海光、摩尔线程等平台，面向自主可控的信创异构计算。",
      "跨系统部署：支持 Windows、Linux、macOS 等操作系统，覆盖本地工作站、服务器和高性能计算平台。"
    ]
  },
  {
    label: "增强采样与自由能计算",
    eyebrow: "核心能力",
    title: "增强采样与自由能计算",
    body: "针对构象变化、稀有事件和自由能景观等分子模拟难题，SPONGE 集成增强采样方法，帮助研究者更有效地探索复杂分子体系。",
    points: [
      "为什么需要增强采样：常规分子动力学很难在有限时间内跨越高能垒并充分访问重要构象，增强采样可以提高稀有事件、构象转变和自由能景观的探索效率。",
      "方法支持：覆盖伞形采样、metadynamics、选择性温度积分等增强采样算法，以及 MM/GBSA、自由能微扰等自由能计算方法。"
    ]
  },
  {
    label: "AI 增强分子模拟方法",
    eyebrow: "核心能力",
    title: "AI 增强分子模拟方法",
    body: "SPONGE 关注 AI 增强分子模拟的方法发展，面向建模、采样、势能、分析和模拟决策等环节探索机器学习与分子模拟的结合，连接机器学习、分子建模与传统分子动力学模拟，支持 AI 驱动的采样、分析和模型辅助模拟思路，并为后续算法扩展和跨工具协作保留清晰的软件接口。",
    points: []
  },
  {
    label: "Agentic MD 自主分子模拟工作流",
    eyebrow: "前沿方向",
    title: "Agentic MD：面向自主分子模拟工作流",
    body: "Agentic MD 面向由 AI 智能体辅助规划、执行、检查和迭代的自主分子模拟工作流。它更像一个正在发展的方向，用来探索模拟任务如何从人工脚本走向可解释的智能协作，探索自主分子模拟与工作流自动化的结合，让智能体参与体系准备、参数检查、任务编排和结果分析，并面向复杂研究流程强调可追踪、可复核、可迭代的模拟决策。",
    points: []
  },
  {
    label: "生物分子模拟应用场景",
    eyebrow: "典型应用场景",
    title: "面向生命科学的生物分子模拟",
    body: "在蛋白质、核酸、膜体系和配体识别等生物分子研究中，SPONGE 可用于构象动力学、分子相互作用、结合自由能和机制解释等问题，帮助研究者从原子尺度理解复杂生命过程。",
    points: [
      "蛋白质与核酸体系：研究构象变化、折叠稳定性、突变影响和分子识别机制。",
      "药物发现与配体结合：支持结合模式分析、结合自由能估计和候选分子筛选。",
      "膜蛋白与复杂生物体系：面向膜环境、溶剂效应和多组分体系中的长时间尺度动力学。"
    ]
  },
  {
    label: "材料分子模拟应用场景",
    eyebrow: "典型应用场景",
    title: "面向材料科学的分子模拟",
    body: "在聚合物、电解液、界面、晶体和软物质等材料体系中，SPONGE 可服务于微观结构、扩散输运、界面作用和热力学性质研究，为材料设计与性能理解提供计算支撑。",
    points: [
      "能源与电解液材料：研究离子溶剂化、扩散输运、界面结构和电化学相关微观机制。",
      "聚合物与软物质体系：分析链段运动、聚集行为、相互作用网络和结构-性能关系。",
      "晶体、界面与复合材料：连接原子尺度结构、界面作用和可观测材料性质。"
    ]
  },
  {
    label: "生态社区与合作伙伴",
    eyebrow: "生态社区",
    title: "连接科研教育与产业研发",
    body: "SPONGE 希望持续建设开放、可复用、可扩展的分子模拟软件生态，为各科研院所的科研与教育、企业的研发和工程化应用提供助力，支持计算化学、分子模拟、分子建模和高性能计算相关教学与研究，也服务药物、材料、能源和智能计算等方向的产业研发场景。目前，SPONGE 已在北京大学本科生课程《计算化学导论》等教学场景中使用，并与北京星使智算科技有限公司等单位探索科研软件、智能计算与产业应用之间的连接。",
    points: []
  }
] as const;

---

<BaseLayout
  lang="zh-CN"
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/"
  alternateLocales={[
    { hreflang: "zh-CN", path: "/" },
    { hreflang: "en", path: "/en" },
    { hreflang: "x-default", path: "/" }
  ]}
  ogImage="/assets/home/sponge-logo-notext.png"
  jsonLd={introJsonLd}
>
  <IntroDeck
    entryLinks={entryLinks}
    switchHref="/en"
    switchLabel="Switch to English"
    slideOneLabel="SPONGE 全称与缩写动画"
    slideTwoLabel="SPONGE 概览"
    fullNameLabel="Simulation Package tOwards Next GEneration molecular modeling"
    molecularModelingText="molecular modeling"
    navLabel="主要入口"
    scrollDownLabel="向下滚动"
    scrollUpLabel="返回"
    overviewEyebrow="SPONGE是什么？"
    overviewTitle="面向下一代分子科学的<br />分子模拟软件"
    overviewBody="SPONGE 由北京大学高毅勤课题组开发，面向众核 CPU、GPU、NPU 等多种硬件平台提供加速的分子动力学模拟能力，并集成丰富的增强采样方法与 AI 驱动算法。"
    contextSlideLabel="为什么需要分子模拟"
    contextEyebrow="为什么需要分子模拟？"
    contextTitle="从科学问题到计算工具"
    contextItems={contextItems}
    featureSlides={featureSlides}
  />
</BaseLayout>
