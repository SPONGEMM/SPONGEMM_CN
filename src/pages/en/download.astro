---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/site/Header.astro";
import { siteNavEn } from "../../data/homepage-en";
---

<BaseLayout
  lang="en"
  title="SPONGEMM | Download"
  description="Download SPONGE molecular simulation software. Content is being prepared."
  canonicalPath="/en/download"
  alternateLocales={[
    { hreflang: "zh-CN", path: "/download" },
    { hreflang: "en", path: "/en/download" },
    { hreflang: "x-default", path: "/download" }
  ]}
>
  <Header navItems={siteNavEn} brandHref="/en" />
  <main>
    <section class="section">
      <div class="container placeholder-page">
        <p class="eyebrow">Download</p>
        <h1>Content coming soon</h1>
        <p>Download links are being prepared. Please check back later.</p>
      </div>
    </section>
  </main>
</BaseLayout>
