---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/site/Header.astro";
import { siteNavEn } from "../../data/homepage-en";
---

<BaseLayout
  lang="en"
  title="SPONGEMM | Docs"
  description="Documentation for the SPONGE molecular simulation software. Content is being prepared."
  canonicalPath="/en/docs"
  alternateLocales={[
    { hreflang: "zh-CN", path: "/docs" },
    { hreflang: "en", path: "/en/docs" },
    { hreflang: "x-default", path: "/docs" }
  ]}
>
  <Header navItems={siteNavEn} brandHref="/en" />
  <main>
    <section class="section">
      <div class="container placeholder-page">
        <p class="eyebrow">Docs</p>
        <h1>Content coming soon</h1>
        <p>SPONGE documentation is being reorganized. Please check back later.</p>
      </div>
    </section>
  </main>
</BaseLayout>
