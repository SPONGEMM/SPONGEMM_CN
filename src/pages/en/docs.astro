---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/site/Header.astro";
import ArrowOutIcon from "../../components/icons/ArrowOutIcon.astro";
import { siteNavEn } from "../../data/homepage-en";
import { getSiteUrl } from "../../lib/site";
import "../../styles/docs-page.css";

const pageTitle = "SPONGEMM | Docs";
const pageDescription = "Choose the documentation for SPONGE 2.0 or SPONGE 1.4.";

const docVersions = [
  {
    version: "2.0",
    tone: "beta",
    href: "/en/docs/2p0",
    cta: "View Docs"
  },
  {
    version: "1.4",
    tone: "stable",
    href: "/en/docs/1p4",
    cta: "View Docs"
  }
] as const;

const siteUrl = getSiteUrl(Astro.site);
const docsJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: pageTitle,
    description: pageDescription,
    url: `${siteUrl}/en/docs`,
    inLanguage: "en",
    isPartOf: { "@type": "WebSite", name: "SPONGEMM", url: siteUrl }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "SPONGE documentation versions",
    itemListElement: docVersions.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `SPONGE ${item.version} Documentation`,
      url: `${siteUrl}${item.href}`
    }))
  }
];
---

<BaseLayout
  lang="en"
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/en/docs"
  alternateLocales={[
    { hreflang: "zh-CN", path: "/docs" },
    { hreflang: "en", path: "/en/docs" },
    { hreflang: "x-default", path: "/docs" }
  ]}
  jsonLd={docsJsonLd}
>
  <Header navItems={siteNavEn} brandHref="/en" />
  <main class="docs-page docs-version-page">
    <section class="docs-hero section">
      <div class="container docs-hero-grid">
        <div class="docs-hero-copy">
          <h1>SPONGE Docs</h1>
        </div>
        <img class="docs-hero-art" src="/assets/docs/molecule-docs.webp" alt="" aria-hidden="true" />
      </div>
    </section>

    <section class="docs-section section">
      <div class="container">
        <div class="docs-version-grid" aria-label="SPONGE documentation version choices">
          {docVersions.map((item) => (
            <a class="docs-version-card" data-tone={item.tone} href={item.href} aria-label={`View SPONGE ${item.version} documentation`}>
              <p class="docs-version-number">{item.version}</p>
              <span class="docs-version-cta">
                {item.cta}
                <ArrowOutIcon size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
