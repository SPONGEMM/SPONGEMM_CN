---
import { getCollection, type CollectionEntry } from "astro:content";
import Article from "../../../components/insights/Article.astro";

export async function getStaticPaths() {
  const entries = await getCollection("insights-en");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<"insights-en">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Article entry={entry} lang="en">
  <Content />
</Article>
