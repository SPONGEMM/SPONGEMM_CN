---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DocsArticle from "../../../../components/docs/DocsArticle.astro";

export async function getStaticPaths() {
  const entries = await getCollection("docs-en", ({ id }) => id.startsWith("2p0/"));
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^2p0\//, "") },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<"docs-en">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsArticle entry={entry} headings={headings} lang="en">
  <Content />
</DocsArticle>

