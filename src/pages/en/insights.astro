---
import Footer from "../../components/site/Footer.astro";
import Header from "../../components/site/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="SPONGEMM | Perspectives & Insights"
  description="Perspectives and insights on molecular modeling, simulation methods, and computational practice."
>
  <Header />
  <main class="container section">
    <section class="panel" style="padding: 2rem; border-radius: 24px;">
      <p class="section-kicker">观点洞见</p>
      <h1 style="margin-top: 0;">Perspectives & Insights</h1>
      <p style="max-width: 720px; color: var(--muted); line-height: 1.8;">
        This section will collect perspectives, observations, and practical reflections on molecular modeling and simulation.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>

