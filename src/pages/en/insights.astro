---
import { getCollection } from "astro:content";
import { siteNavEn } from "../../data/homepage-en";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/site/Header.astro";
import InsightCard from "../../components/insights/InsightCard.astro";
import { getSiteUrl } from "../../lib/site";

const entries = (await getCollection("insights-en"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pageTitle = "SPONGEMM | Insights";
const pageDescription =
  "SPONGE Insights — notes on molecular simulation, molecular modelling and computational chemistry methods. Articles are written in Chinese; contributors can submit via GitHub Pull Request.";

const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric"
});

const siteUrl = getSiteUrl(Astro.site);
const blogJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "SPONGEMM Insights",
    description: pageDescription,
    url: `${siteUrl}/en/insights`,
    inLanguage: "en",
    isPartOf: { "@type": "WebSite", name: "SPONGEMM", url: siteUrl }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "SPONGEMM Insights articles",
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: entries.length,
    itemListElement: entries.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${siteUrl}/en/insights/${entry.id}`,
      name: entry.data.title
    }))
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  canonicalPath="/en/insights"
  alternateLocales={[
    { hreflang: "zh-CN", path: "/insights" },
    { hreflang: "en", path: "/en/insights" },
    { hreflang: "x-default", path: "/insights" }
  ]}
  jsonLd={blogJsonLd}
>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title="SPONGEMM Insights RSS"
    href="/en/rss.xml"
  />
  <Header navItems={siteNavEn} brandHref="/en" />
  <main class="insights-page">
    <div class="insights-shell">
      <p class="eyebrow">Insights</p>

      {entries.length === 0 ? (
        <p class="insights-empty">No posts yet.</p>
      ) : (
        <ul class="insights-list">
          {entries.map((entry) => (
            <li>
              <InsightCard entry={entry} hrefPrefix="/en/insights" dateFmt={dateFmt} />
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .insights-page {
    padding: 80px 0 160px;
  }
  .insights-shell {
    width: min(calc(100% - 48px), 880px);
    margin: 0 auto;
  }
  .insights-shell .eyebrow {
    margin-bottom: 32px;
  }
  .insights-empty {
    padding: 48px 0;
    color: var(--muted);
  }
  .insights-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }

  @media (max-width: 720px) {
    .insights-page {
      padding: 56px 0 96px;
    }
  }
</style>
