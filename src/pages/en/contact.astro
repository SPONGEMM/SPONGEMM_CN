---
import { siteNavEn } from "../../data/homepage-en";
import Header from "../../components/site/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const cards = [
  {
    kind: "institution",
    num: "01",
    tag: "Beijing",
    title: "Peking University",
    subtitle: "College of Chemistry and Molecular Engineering",
    addressLines: ["No. 202 Chengfu Road, Haidian District, Beijing", "Postal code 100871"],
    action: {
      label: "yijiexia@pku.edu.cn",
      href: "mailto:yijiexia@pku.edu.cn",
      icon: "mail"
    }
  },
  {
    kind: "institution",
    num: "02",
    tag: "Hangzhou",
    title: "Westlake University",
    subtitle: "School of Science",
    addressLines: ["No. 600 Dunyu Road, Xihu District, Hangzhou · Yungu Campus", "Postal code 310030"],
    action: {
      label: "xiayijie@westlake.edu.cn",
      href: "mailto:xiayijie@westlake.edu.cn",
      icon: "mail"
    }
  },
  {
    kind: "qq",
    num: "03",
    tag: "QQ Group",
    title: "SPONGE user group",
    subtitle: "Scan to join",
    image: "/assets/contact/qq.jpg",
    imageAlt: "SPONGE user QQ group QR code"
  },
  {
    kind: "github",
    num: "04",
    tag: "Source code",
    title: "GitHub",
    subtitle: "Source code & website source",
    repos: [
      { label: "spongemm/SPONGE", href: "https://github.com/spongemm/SPONGE", note: "Project source" },
      { label: "spongemm/spongemm_cn", href: "https://github.com/spongemm/spongemm_cn", note: "Website source" }
    ]
  }
];

const pageTitle = "SPONGEMM | Contact";
const pageDescription =
  "Contact information for the SPONGE molecular simulation project: offices at Peking University (College of Chemistry and Molecular Engineering) and Westlake University (School of Science), developer email, QQ user group and GitHub repositories.";
const siteUrl = "https://spongemm.cn";

const contactJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: pageTitle,
    description: pageDescription,
    url: `${siteUrl}/en/contact`,
    inLanguage: "en",
    isPartOf: {
      "@type": "WebSite",
      name: "SPONGEMM",
      url: siteUrl
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "SPONGEMM",
    url: siteUrl,
    parentOrganization: {
      "@type": "CollegeOrUniversity",
      name: "Peking University",
      url: "https://english.pku.edu.cn/"
    },
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "Academic inquiry (Peking University)",
        email: "yijiexia@pku.edu.cn",
        areaServed: "CN",
        availableLanguage: ["en", "zh-CN"]
      },
      {
        "@type": "ContactPoint",
        contactType: "Academic inquiry (Westlake University)",
        email: "xiayijie@westlake.edu.cn",
        areaServed: "CN",
        availableLanguage: ["en", "zh-CN"]
      }
    ],
    location: [
      {
        "@type": "Place",
        name: "Peking University, College of Chemistry and Molecular Engineering",
        address: {
          "@type": "PostalAddress",
          streetAddress: "No. 202 Chengfu Road",
          postalCode: "100871",
          addressLocality: "Haidian District",
          addressRegion: "Beijing",
          addressCountry: "CN"
        }
      },
      {
        "@type": "Place",
        name: "Westlake University, School of Science",
        address: {
          "@type": "PostalAddress",
          streetAddress: "No. 600 Dunyu Road, Yungu Campus",
          postalCode: "310030",
          addressLocality: "Xihu District",
          addressRegion: "Hangzhou",
          addressCountry: "CN"
        }
      }
    ],
    sameAs: [
      "https://github.com/spongemm",
      "https://github.com/spongemm/SPONGE",
      "https://github.com/spongemm/spongemm_cn"
    ]
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  canonicalPath="/en/contact"
  alternateLocales={[
    { hreflang: "zh-CN", path: "/contact" },
    { hreflang: "en", path: "/en/contact" },
    { hreflang: "x-default", path: "/contact" }
  ]}
  ogImage="/assets/home/sponge-logo-notext.png"
  jsonLd={contactJsonLd}
>
  <Header navItems={siteNavEn} brandHref="/en" />
  <main class="contact-page">
    <div class="contact-bg" aria-hidden="true"></div>

    <section class="contact-hero container">
      <p class="contact-eyebrow">Contact</p>
      <h1 class="contact-title">
        <span class="contact-title-en-main">Drop us</span>
        <span class="contact-title-en">a line<span class="contact-title-period">.</span></span>
      </h1>
      <p class="contact-lede">
        SPONGE is developed and maintained by the Yi Qin Gao group at Peking University together with collaborating teams.
      </p>
    </section>

    <section class="contact-grid container">
      {cards.map((c) => (
        <article class="c-card">
          <header class="c-head">
            <span class="c-num">{c.num}</span>
            <span class="c-tag">{c.tag}</span>
          </header>

          <div class="c-body">
            <h2 class="c-title">{c.title}</h2>
            <p class="c-sub">{c.subtitle}</p>
          </div>

          {c.kind === "institution" && (
            <div class="c-address">
              {c.addressLines.map((line) => <p>{line}</p>)}
            </div>
          )}

          {c.kind === "qq" && (
            <div class="c-qr">
              <div class="c-qr-frame">
                <img src={c.image} alt={c.imageAlt} loading="lazy" />
              </div>
            </div>
          )}

          {c.kind === "github" && (
            <div class="c-repos">
              {c.repos.map((r) => (
                <a class="c-repo-row" href={r.href} target="_blank" rel="noreferrer">
                  <span class="c-repo-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                      <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.48v-1.68c-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1.01.07 1.54 1.07 1.54 1.07.9 1.58 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 2.5-.35c.85 0 1.71.12 2.5.35 1.9-1.33 2.74-1.05 2.74-1.05.56 1.41.21 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.35 4.8-4.59 5.05.36.32.68.94.68 1.9v2.82c0 .26.18.57.69.48A10.34 10.34 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/>
                    </svg>
                  </span>
                  <span class="c-repo-text">
                    <span class="c-repo-name">{r.label}</span>
                    <span class="c-repo-note">{r.note}</span>
                  </span>
                  <svg class="c-repo-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 19 19 5"/>
                    <path d="M9 5h10v10"/>
                  </svg>
                </a>
              ))}
            </div>
          )}

          {c.action && (
            <a
              class="c-pill"
              href={c.action.href}
              target={c.action.icon === "external" ? "_blank" : undefined}
              rel={c.action.icon === "external" ? "noreferrer" : undefined}
            >
              {c.action.icon === "mail" ? (
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2"/>
                  <path d="m4 7 8 6 8-6"/>
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 19 19 5"/>
                  <path d="M9 5h10v10"/>
                </svg>
              )}
              <span>{c.action.label}</span>
            </a>
          )}
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .contact-page {
    position: relative;
    padding: 96px 0 160px;
    overflow: hidden;
  }
  .contact-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(60% 50% at 80% 0%, rgba(78, 161, 255, 0.18), transparent 70%),
      radial-gradient(50% 40% at 0% 30%, rgba(29, 105, 181, 0.10), transparent 70%);
  }
  .contact-page > * {
    position: relative;
    z-index: 1;
  }

  .contact-eyebrow {
    margin: 0;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: 0.76rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--primary);
    font-weight: 600;
  }

  .contact-hero {
    padding-bottom: 64px;
  }
  .contact-title {
    margin: 24px 0 0;
    display: grid;
    gap: 4px;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-weight: 600;
    font-size: clamp(2.6rem, 8vw, 6.4rem);
    line-height: 0.96;
    letter-spacing: -0.035em;
  }
  .contact-title-en-main {
    color: var(--text);
  }
  .contact-title-en {
    font-family: Georgia, "Source Serif Pro", "Iowan Old Style", serif;
    font-style: italic;
    font-weight: 400;
    color: var(--primary);
    letter-spacing: -0.02em;
  }
  .contact-title-period {
    color: var(--accent);
  }
  .contact-lede {
    margin: 28px 0 0;
    max-width: 640px;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--muted);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .c-card {
    position: relative;
    padding: 36px 36px 30px;
    border-radius: 28px;
    background: var(--surface-strong);
    border: 1px solid var(--line);
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 22px;
    overflow: hidden;
    transition: border-color 220ms ease,
                transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 280ms ease;
  }
  .c-card::before {
    content: "";
    position: absolute;
    top: -120px;
    right: -120px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(78, 161, 255, 0.12), transparent 70%);
    pointer-events: none;
    transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c-card:hover {
    border-color: rgba(29, 105, 181, 0.35);
    transform: translateY(-4px);
    box-shadow: 0 30px 60px rgba(17, 74, 133, 0.08);
  }
  .c-card:hover::before {
    transform: translate(-30px, 30px);
  }

  .c-head {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--primary);
  }
  .c-num {
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    font-weight: 600;
  }
  .c-tag {
    font-family: Georgia, "Source Serif Pro", serif;
    font-style: italic;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .c-tag::before {
    content: "";
    display: inline-block;
    width: 18px;
    height: 1px;
    margin-right: 12px;
    vertical-align: middle;
    background: rgba(29, 105, 181, 0.4);
  }

  .c-body {
    display: grid;
    gap: 6px;
  }
  .c-title {
    margin: 0;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-weight: 600;
    font-size: clamp(1.5rem, 2.4vw, 1.95rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .c-sub {
    margin: 0;
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.4;
  }
  .c-sub-en {
    margin: 0;
    color: var(--muted);
    font-style: italic;
    font-family: Georgia, "Source Serif Pro", serif;
    font-size: 0.92rem;
  }

  .c-address {
    align-self: end;
    color: var(--muted);
    line-height: 1.7;
    font-size: 0.95rem;
  }
  .c-address p {
    margin: 0;
  }
  .c-address p + p {
    margin-top: 4px;
  }

  .c-qr {
    align-self: end;
    display: flex;
  }
  .c-qr-frame {
    width: 168px;
    height: 168px;
    border-radius: 18px;
    background: #fff;
    border: 1px solid var(--line);
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .c-qr-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 8px;
  }

  /* GitHub repos list */
  .c-repos {
    grid-row: 3 / 5;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
  }
  .c-repo-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.6);
    color: var(--text);
    transition: border-color 220ms ease, background 220ms ease, transform 220ms ease;
  }
  .c-repo-row:hover {
    border-color: rgba(29, 105, 181, 0.4);
    background: rgba(29, 105, 181, 0.04);
  }
  .c-repo-icon {
    color: var(--primary-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .c-repo-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .c-repo-name {
    font-family: "Space Grotesk", "Inter", monospace;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--primary-strong);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .c-repo-note {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .c-repo-arrow {
    color: var(--muted);
    transition: transform 220ms ease, color 220ms ease;
  }
  .c-repo-row:hover .c-repo-arrow {
    color: var(--primary);
    transform: translate(2px, -2px);
  }

  .c-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-radius: 999px;
    background: rgba(29, 105, 181, 0.08);
    color: var(--primary-strong);
    font-family: "Space Grotesk", "Inter", monospace;
    font-size: 0.96rem;
    width: fit-content;
    justify-self: start;
    transition: background 220ms ease, transform 220ms ease;
  }
  .c-pill svg {
    flex-shrink: 0;
    transition: transform 220ms ease;
  }
  .c-pill:hover {
    background: rgba(29, 105, 181, 0.16);
  }
  .c-pill:hover svg {
    transform: translate(2px, -2px);
  }

  @media (max-width: 880px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .contact-page {
      padding: 56px 0 96px;
    }
    .c-card {
      padding: 28px 26px 26px;
    }
  }
</style>
