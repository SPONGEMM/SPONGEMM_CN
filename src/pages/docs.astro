---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/site/Header.astro";
import ArrowOutIcon from "../components/icons/ArrowOutIcon.astro";
import { getSiteUrl } from "../lib/site";
import "../styles/docs-page.css";

const pageTitle = "SPONGEMM | 文档";
const pageDescription = "选择 SPONGE 2.0 或 SPONGE 1.4 的使用文档。";

const docVersions = [
  {
    version: "2.0",
    tone: "beta",
    href: "/docs/2p0",
    cta: "查看文档"
  },
  {
    version: "1.4",
    tone: "stable",
    href: "/docs/1p4",
    cta: "查看文档"
  }
] as const;

const siteUrl = getSiteUrl(Astro.site);
const docsJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: pageTitle,
    description: pageDescription,
    url: `${siteUrl}/docs`,
    inLanguage: "zh-CN",
    isPartOf: { "@type": "WebSite", name: "SPONGEMM", url: siteUrl }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "SPONGE 文档版本",
    itemListElement: docVersions.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `SPONGE ${item.version} 文档`,
      url: `${siteUrl}${item.href}`
    }))
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/docs"
  alternateLocales={[
    { hreflang: "zh-CN", path: "/docs" },
    { hreflang: "en", path: "/en/docs" },
    { hreflang: "x-default", path: "/docs" }
  ]}
  jsonLd={docsJsonLd}
>
  <Header />
  <main class="docs-page docs-version-page">
    <section class="docs-hero section">
      <div class="container docs-hero-grid">
        <div class="docs-hero-copy">
          <h1>SPONGE 文档</h1>
        </div>
        <img class="docs-hero-art" src="/assets/docs/molecule-docs.webp" alt="" aria-hidden="true" />
      </div>
    </section>

    <section class="docs-section section">
      <div class="container">
        <div class="docs-version-grid" aria-label="SPONGE 文档版本选择">
          {docVersions.map((item) => (
            <a class="docs-version-card" data-tone={item.tone} href={item.href} aria-label={`查看 SPONGE ${item.version} 文档`}>
              <p class="docs-version-number">{item.version}</p>
              <span class="docs-version-cta">
                {item.cta}
                <ArrowOutIcon size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
