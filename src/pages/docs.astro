---
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import LegacyDocsLayout from "../components/legacy/LegacyDocsLayout.astro";
import { getLegacyTitleByHref } from "../data/legacy-navigation";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadLegacyMarkdown } from "../lib/legacy-markdown";

const defaultRoute = "文档/SPONGE2.0/getting-started";
const page = await loadLegacyMarkdown(defaultRoute);

if (!page) {
  throw new Error("Missing legacy docs overview page");
}

const Content = page.module.default;
const title = getLegacyTitleByHref(`/${defaultRoute}`) ?? page.title;
---

<BaseLayout title="SPONGEMM | 文档">
  <Header />
  <main>
    <LegacyDocsLayout section="docs" currentPath={`/${defaultRoute}`} title={title}>
      <div class="legacy-markdown-body">
        <Content />
      </div>
    </LegacyDocsLayout>
  </main>
  <Footer />
</BaseLayout>
