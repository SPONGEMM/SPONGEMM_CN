---
import LegacyDocsLayout from "../components/legacy/LegacyDocsLayout.astro";
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const videos = [
  {
    label: "2025 年工作坊回放",
    src: "https://player.bilibili.com/player.html?bvid=BV1CHewz1ELg&page=1&high_quality=1",
    external: "https://www.bilibili.com/video/BV1CHewz1ELg"
  },
  {
    label: "2023 年工作坊回放",
    src: "https://player.bilibili.com/player.html?aid=575188057&bvid=BV1Uz4y1T7RG&cid=1244884759&p=1&high_quality=1"
  },
  {
    label: "2022 年工作坊回放",
    src: "https://player.bilibili.com/player.html?aid=599417109&bvid=BV1pB4y167yS&cid=802186371&p=1&high_quality=1"
  },
  {
    label: "2021 年工作坊回放",
    src: "https://player.bilibili.com/player.html?aid=932411880&bvid=BV1sM4y1L7sy&cid=393849337&p=1&high_quality=1"
  }
];
---

<BaseLayout title="SPONGEMM | 工作坊视频">
  <Header />
  <main>
    <LegacyDocsLayout section="tutorials" currentPath="/工作坊视频" title="工作坊视频">
      <div class="legacy-markdown-body">
        <div class="workshop-video-grid">
          {videos.map((video) => (
            <article class="workshop-video-card">
              <h2>{video.label}</h2>
              {video.src.includes("player.bilibili.com") ? (
                <div class="workshop-video-frame">
                  <iframe
                    src={video.src}
                    scrolling="no"
                    border="0"
                    frameborder="no"
                    framespacing="0"
                    allowfullscreen="true"
                  />
                </div>
              ) : (
                <a class="workshop-video-link" href={video.src} target="_blank" rel="noreferrer">
                  打开 bilibili 视频
                  <span>{video.external ?? video.src}</span>
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    </LegacyDocsLayout>
  </main>
  <Footer />
</BaseLayout>
