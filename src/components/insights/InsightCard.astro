---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"insights"> | CollectionEntry<"insights-en">;
  hrefPrefix: string;
  dateFmt: Intl.DateTimeFormat;
}
const { entry, hrefPrefix, dateFmt } = Astro.props;
---

<a class="insights-card" href={`${hrefPrefix}/${entry.slug}`}>
  <h2 class="insights-card-title">{entry.data.title}</h2>
  <p class="insights-card-desc">{entry.data.description}</p>
  <div class="insights-card-foot">
    <div class="insights-card-author">
      {entry.data.avatar ? (
        <img
          class="insights-card-avatar"
          src={entry.data.avatar}
          alt={entry.data.author}
          width="28"
          height="28"
          loading="lazy"
        />
      ) : (
        <span class="insights-card-avatar insights-card-avatar--fallback" aria-hidden="true">
          {entry.data.author.slice(0, 1)}
        </span>
      )}
      <span>{entry.data.author}</span>
    </div>
    <time class="insights-card-date" datetime={entry.data.date.toISOString()}>
      {dateFmt.format(entry.data.date)}
    </time>
  </div>
</a>

<style>
  .insights-card {
    display: block;
    padding: 28px 32px 24px;
    border-radius: 20px;
    background: var(--surface-strong);
    border: 1px solid var(--line);
    color: var(--text);
    transition: border-color 220ms ease,
                transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 280ms ease;
  }
  .insights-card:hover {
    border-color: rgba(29, 105, 181, 0.4);
    transform: translateY(-3px);
    box-shadow: 0 20px 50px rgba(17, 74, 133, 0.06);
  }
  .insights-card-title {
    margin: 0 0 10px;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-weight: 600;
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .insights-card-desc {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }
  .insights-card-foot {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .insights-card-author {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 0.94rem;
    font-weight: 500;
  }
  .insights-card-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
    flex-shrink: 0;
  }
  .insights-card-avatar--fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(29, 105, 181, 0.12);
    color: var(--primary-strong);
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-weight: 600;
    font-size: 0.82rem;
  }
  .insights-card-date {
    font-family: "Space Grotesk", "Inter", monospace;
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  @media (max-width: 720px) {
    .insights-card {
      padding: 22px 22px 20px;
      border-radius: 18px;
    }
  }
</style>
