---
import {
  legacySectionGroups,
  legacySectionMeta,
  type LegacySectionKey
} from "../../data/legacy-navigation";

const { section, currentPath, title } = Astro.props as {
  section: LegacySectionKey;
  currentPath: string;
  title: string;
};

const meta = legacySectionMeta[section];
const groups = legacySectionGroups[section];
const normalizedCurrentPath = currentPath.replace(/\.md$/, "").replace(/\/README$/, "").replace(/\/+$/, "");
---

<section class="section legacy-docs-section">
  <div class="container legacy-docs-layout">
    <aside class="legacy-sidebar">
      <div class="legacy-sidebar-inner">
        <a class:list={["legacy-sidebar-home", normalizedCurrentPath === meta.homeHref && "is-active"]} href={meta.homeHref}>
          {meta.overviewTitle}
        </a>

        {groups.map((group) => (
          <section class="legacy-sidebar-group">
            <h2>{group.title}</h2>
            <nav>
              {group.items.map((item) => (
                <a class:list={["legacy-sidebar-link", normalizedCurrentPath === item.href && "is-active"]} href={item.href}>
                  <span>{item.title}</span>
                  {item.note && <small>{item.note}</small>}
                </a>
              ))}
            </nav>
          </section>
        ))}
      </div>
    </aside>

    <article class="legacy-docs-main">
      <div class="legacy-docs-main-head">
        <p class="section-eyebrow">{meta.title}</p>
        <h1>{title}</h1>
      </div>
      <div class="legacy-docs-body panel">
        <slot />
      </div>
    </article>

    <aside class="legacy-toc" data-legacy-toc-root hidden>
      <div class="legacy-toc-inner">
        <p class="legacy-toc-title">本页目录</p>
        <nav class="legacy-toc-links" data-legacy-toc-links></nav>
      </div>
    </aside>
  </div>
</section>

<script>
  const tocRoot = document.querySelector("[data-legacy-toc-root]");
  const tocLinksRoot = document.querySelector("[data-legacy-toc-links]");
  const contentRoot = document.querySelector(".legacy-markdown-body");

  if (tocRoot instanceof HTMLElement && tocLinksRoot instanceof HTMLElement && contentRoot instanceof HTMLElement) {
    const normalizeLegacyHref = (href) => {
      if (!href || href.startsWith("#") || /^[a-z]+:/i.test(href)) {
        return href;
      }

      try {
        const resolved = new URL(href, window.location.href);
        if (resolved.origin !== window.location.origin) {
          return href;
        }

        let normalizedPathname = resolved.pathname
          .replace(/\/README\.md$/i, "")
          .replace(/\.md$/i, "");

        if (!normalizedPathname.endsWith("/")) {
          normalizedPathname += "/";
        }

        return `${normalizedPathname}${resolved.search}${resolved.hash}`;
      } catch {
        return href;
      }
    };

    contentRoot.querySelectorAll("a[href]").forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) {
        return;
      }

      const href = link.getAttribute("href");
      const normalizedHref = normalizeLegacyHref(href);

      if (normalizedHref && normalizedHref !== href) {
        link.setAttribute("href", normalizedHref);
      }
    });

    contentRoot.addEventListener(
      "click",
      (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }

        const link = target.closest("a[href]");
        if (!(link instanceof HTMLAnchorElement)) {
          return;
        }

        const href = link.getAttribute("href");
        const normalizedHref = normalizeLegacyHref(href);

        if (!normalizedHref || normalizedHref === href) {
          return;
        }

        event.preventDefault();
        window.location.href = normalizedHref;
      },
      true
    );

    const slugify = (value) =>
      value
        .toLowerCase()
        .trim()
        .replace(/[\s/]+/g, "-")
        .replace(/[^\w\-\u4e00-\u9fa5]+/g, "")
        .replace(/\-+/g, "-");

    const headings = Array.from(contentRoot.querySelectorAll("h2, h3"));

    const items = headings
      .map((heading, index) => {
        const text = heading.textContent?.trim();
        if (!text) return null;
        if (!heading.id) {
          heading.id = `${slugify(text) || "section"}-${index}`;
        }
        return {
          id: heading.id,
          text,
          level: heading.tagName.toLowerCase()
        };
      })
      .filter(Boolean);

    if (items.length > 0) {
      tocRoot.hidden = false;
      tocLinksRoot.innerHTML = items
        .map(
          (item) =>
            `<a class="legacy-toc-link ${item.level === "h3" ? "is-nested" : ""}" href="#${item.id}" data-toc-id="${item.id}">${item.text}</a>`
        )
        .join("");

      const tocLinks = Array.from(tocLinksRoot.querySelectorAll("[data-toc-id]"));

      const setActive = (id) => {
        tocLinks.forEach((link) => {
          link.classList.toggle("is-active", link.getAttribute("data-toc-id") === id);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

          if (visible[0]?.target instanceof HTMLElement) {
            setActive(visible[0].target.id);
          }
        },
        {
          rootMargin: "-96px 0px -70% 0px",
          threshold: [0, 1]
        }
      );

      headings.forEach((heading) => observer.observe(heading));
      if (items[0]) setActive(items[0].id);
    }
  }
</script>
