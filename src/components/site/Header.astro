---
import { siteNav } from "../../data/homepage";

const {
  navItems = siteNav,
  brandHref = "/",
  githubLabel = "GitHub"
} = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={brandHref}>
      <img class="brand-logo" src="/assets/home/sponge-logo-notext.png" alt="SPONGE logo" />
      <span>SPONGEMM</span>
    </a>
    <nav class="nav">
      {navItems.map((item) => (
        item.icon === "github" ? (
          <a class="nav-icon-link" href={item.href} target="_blank" rel="noreferrer" aria-label={githubLabel}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.48v-1.68c-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1.01.07 1.54 1.07 1.54 1.07.9 1.58 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 2.5-.35c.85 0 1.71.12 2.5.35 1.9-1.33 2.74-1.05 2.74-1.05.56 1.41.21 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.35 4.8-4.59 5.05.36.32.68.94.68 1.9v2.82c0 .26.18.57.69.48A10.34 10.34 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" fill="currentColor" />
            </svg>
          </a>
        ) : (
          <a href={item.href}>{item.label}</a>
        )
      ))}
    </nav>
  </div>
</header>
