---
import { siteNav } from "../../data/homepage";
import GitHubIcon from "../icons/GitHubIcon.astro";

const {
  navItems = siteNav,
  brandHref = "/",
  githubLabel = "GitHub"
} = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={brandHref}>
      <img class="brand-logo" src="/assets/home/sponge-logo-notext.webp" alt="SPONGE logo" />
      <span>SPONGEMM</span>
    </a>
    <nav class="nav">
      {navItems.map((item) => (
        item.icon === "github" ? (
          <a class="nav-icon-link" href={item.href} target="_blank" rel="noreferrer" aria-label={githubLabel}>
            <GitHubIcon />
          </a>
        ) : (
          <a href={item.href}>{item.label}</a>
        )
      ))}
    </nav>
  </div>
</header>
