---
type EntryLink = {
  label: string;
  href: string;
  variant: "primary" | "outline";
  icon: string;
};

type ContextItem = {
  title: string;
  body: string;
};

type FeatureSlide = {
  label: string;
  eyebrow: string;
  title: string;
  body: string;
  points: string[];
};

interface Props {
  entryLinks: EntryLink[];
  switchHref: string;
  switchLabel: string;
  slideOneLabel: string;
  slideTwoLabel: string;
  fullNameLabel: string;
  molecularModelingText: string;
  navLabel: string;
  scrollDownLabel: string;
  scrollUpLabel: string;
  overviewEyebrow: string;
  overviewTitle: string;
  overviewBody: string;
  contextSlideLabel: string;
  contextEyebrow: string;
  contextTitle: string;
  contextItems: ContextItem[];
  featureSlides: FeatureSlide[];
}

const {
  entryLinks,
  switchHref,
  switchLabel,
  slideOneLabel,
  slideTwoLabel,
  fullNameLabel,
  molecularModelingText,
  navLabel,
  scrollDownLabel,
  scrollUpLabel,
  overviewEyebrow,
  overviewTitle,
  overviewBody,
  contextSlideLabel,
  contextEyebrow,
  contextTitle,
  contextItems,
  featureSlides
} = Astro.props;

const acronymWords = [
  { lead: "S", rest: "imulation" },
  { lead: "P", rest: "ackage" },
  { lead: "O", prefix: "t", rest: "wards" },
  { lead: "N", rest: "ext" },
  { lead: "GE", rest: "neration" }
];
---

<main class="sponge-deck" data-deck data-intro-key={`sponge-intro-seen:${Astro.url.pathname}`}>
  <a class="sponge-language-switch" href={switchHref} aria-label={switchLabel} title={switchLabel}>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path d="M5 8l6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M4 14l6-6 2-3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M2 5h12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M7 2h1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M22 22l-5-10-5 10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M14 18h6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>

  <section class="deck-slide is-active" data-slide="0" aria-label={slideOneLabel}>
    <img class="sponge-intro-mark" src="/background.png" alt="" aria-hidden="true" loading="lazy" decoding="async" />
    <div class="deck-slide-body">
      <div class="sponge-intro-stage">
        <div class="sponge-full-name" aria-label={fullNameLabel}>
          {acronymWords.map((word, index) => (
            <span class="sponge-word" style={`--word-index: ${index}`}>
              {word.prefix && <span class="sponge-prefix">{word.prefix}</span>}
              <span class="sponge-lead">{word.lead}</span>
              <span class="sponge-rest">{word.rest}</span>
            </span>
          ))}
          <span class="sponge-word sponge-tail" style="--word-index: 5">{molecularModelingText}</span>
        </div>

        <h1 class="sponge-acronym">SPONGE</h1>
      </div>

      <nav class="sponge-entry" aria-label={navLabel}>
        {entryLinks.map((link, index) => (
          <a class={`sponge-entry-link is-${link.variant}`} href={link.href} style={`--entry-index: ${index}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d={link.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{link.label}</span>
          </a>
        ))}
      </nav>
    </div>

    <button type="button" class="sponge-scroll-hint" data-deck-next aria-label={scrollDownLabel}>
      <span>{scrollDownLabel}</span>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </section>

  <section class="deck-slide is-future" data-slide="1" aria-label={slideTwoLabel}>
    <div class="deck-slide-body deck-overview">
      <p class="deck-eyebrow">{overviewEyebrow}</p>
      <h2 class="deck-title" set:html={overviewTitle} />
      <p class="deck-body">{overviewBody}</p>
    </div>

    <button type="button" class="sponge-scroll-hint up" data-deck-prev aria-label={scrollUpLabel}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>{scrollUpLabel}</span>
    </button>

    <button type="button" class="sponge-scroll-hint" data-deck-next aria-label={scrollDownLabel}>
      <span>{scrollDownLabel}</span>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </section>

  <section class="deck-slide is-future" data-slide="2" aria-label={contextSlideLabel}>
    <div class="deck-slide-body deck-context">
      <div class="deck-context-heading">
        <p class="deck-eyebrow">{contextEyebrow}</p>
        <h2 class="deck-title">{contextTitle}</h2>
      </div>

      <div class="deck-context-grid">
        {contextItems.map((item) => (
          <article class="deck-context-item">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>

    <button type="button" class="sponge-scroll-hint up" data-deck-prev aria-label={scrollUpLabel}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>{scrollUpLabel}</span>
    </button>

    {featureSlides.length > 0 && (
      <button type="button" class="sponge-scroll-hint" data-deck-next aria-label={scrollDownLabel}>
        <span>{scrollDownLabel}</span>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    )}
  </section>

  {featureSlides.map((slide, index) => {
    const isLast = index === featureSlides.length - 1;

    return (
      <section class="deck-slide is-future" data-slide={index + 3} aria-label={slide.label}>
        <article class="deck-slide-body deck-feature">
          <p class="deck-eyebrow">{slide.eyebrow}</p>
          <h2 class="deck-title">{slide.title}</h2>
          <p class="deck-body">{slide.body}</p>
          {slide.points.length > 0 && (
            <ul class={`deck-feature-points has-${slide.points.length}-points`}>
              {slide.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          )}
        </article>

        <button type="button" class="sponge-scroll-hint up" data-deck-prev aria-label={scrollUpLabel}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{scrollUpLabel}</span>
        </button>

        {!isLast && (
          <button type="button" class="sponge-scroll-hint" data-deck-next aria-label={scrollDownLabel}>
            <span>{scrollDownLabel}</span>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        )}
      </section>
    );
  })}
</main>

<script>
  const deck = document.querySelector<HTMLElement>("[data-deck]");
  if (deck) {
    const slides = Array.from(deck.querySelectorAll<HTMLElement>(".deck-slide"));
    const INTRO_LOCK_MS = 3800;
    const COOLDOWN_MS = 750;
    const introKey = deck.dataset.introKey ?? "sponge-intro-seen";
    let current = 0;
    let ready = false;
    let lastTrigger = 0;
    let touchStartY: number | null = null;
    let touchStartScrollable: HTMLElement | null = null;
    let hasSeenIntro = false;

    try {
      hasSeenIntro = window.localStorage.getItem(introKey) === "true";
    } catch {
      hasSeenIntro = false;
    }

    const unlockReady = () => {
      ready = true;
      deck.classList.add("is-ready");
      try {
        window.localStorage.setItem(introKey, "true");
      } catch {
        // Ignore storage failures; the intro still works without persistence.
      }
    };

    if (hasSeenIntro) {
      deck.classList.add("has-seen-intro");
      unlockReady();
    } else {
      window.setTimeout(unlockReady, INTRO_LOCK_MS);
    }

    const goto = (index: number) => {
      if (index < 0 || index >= slides.length || index === current) return;
      const now = performance.now();
      if (now - lastTrigger < COOLDOWN_MS) return;
      lastTrigger = now;
      const direction = index > current ? "down" : "up";
      slides[current].classList.remove("is-active");
      slides[current].classList.add(direction === "down" ? "is-past" : "is-future");
      slides[index].classList.remove("is-past", "is-future");
      slides[index].classList.add("is-active");
      current = index;
    };

    const next = () => goto(current + 1);
    const prev = () => goto(current - 1);
    const getScrollableBody = (target: EventTarget | null) => {
      if (!(target instanceof Element)) return null;
      const body = target.closest<HTMLElement>(".deck-slide-body");
      if (!body || body.scrollHeight <= body.clientHeight + 1) return null;
      return body;
    };
    const canScrollBody = (body: HTMLElement, deltaY: number) => {
      const atTop = body.scrollTop <= 0;
      const atBottom = body.scrollTop + body.clientHeight >= body.scrollHeight - 1;
      return deltaY > 0 ? !atBottom : !atTop;
    };

    deck.addEventListener(
      "wheel",
      (event) => {
        if (!ready) {
          event.preventDefault();
          return;
        }
        if (Math.abs(event.deltaY) < 12) return;
        const scrollableBody = getScrollableBody(event.target);
        if (scrollableBody && canScrollBody(scrollableBody, event.deltaY)) return;
        event.preventDefault();
        if (event.deltaY > 0) next();
        else prev();
      },
      { passive: false }
    );

    deck.addEventListener("touchstart", (event) => {
      touchStartY = event.touches[0]?.clientY ?? null;
      touchStartScrollable = getScrollableBody(event.target);
    }, { passive: true });

    deck.addEventListener("touchend", (event) => {
      if (!ready || touchStartY == null) return;
      const endY = event.changedTouches[0]?.clientY;
      if (endY == null) return;
      const dy = touchStartY - endY;
      if (Math.abs(dy) < 50) return;
      if (touchStartScrollable && canScrollBody(touchStartScrollable, dy)) {
        touchStartY = null;
        touchStartScrollable = null;
        return;
      }
      if (dy > 0) next();
      else prev();
      touchStartY = null;
      touchStartScrollable = null;
    }, { passive: true });

    window.addEventListener("keydown", (event) => {
      if (!ready) return;
      if (["ArrowDown", "PageDown", " "].includes(event.key)) {
        event.preventDefault();
        next();
      } else if (["ArrowUp", "PageUp"].includes(event.key)) {
        event.preventDefault();
        prev();
      }
    });

    deck.querySelectorAll<HTMLElement>("[data-deck-next]").forEach((el) => {
      el.addEventListener("click", () => next());
    });
    deck.querySelectorAll<HTMLElement>("[data-deck-prev]").forEach((el) => {
      el.addEventListener("click", () => prev());
    });
  }
</script>

<style>
  .sponge-deck {
    position: relative;
    height: 100svh;
    width: 100%;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 18%, rgba(78, 161, 255, 0.14), transparent 32%),
      radial-gradient(circle at 85% 10%, rgba(29, 105, 181, 0.12), transparent 30%),
      var(--bg);
    color: var(--text);
  }

  .sponge-language-switch {
    position: absolute;
    top: clamp(18px, 3vw, 34px);
    right: clamp(18px, 4vw, 48px);
    z-index: 5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 42px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    color: var(--primary);
    box-shadow: 0 10px 26px rgba(17, 74, 133, 0.1);
    backdrop-filter: blur(16px);
    cursor: pointer;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .sponge-language-switch:hover {
    border-color: color-mix(in srgb, var(--primary) 48%, transparent);
    background: var(--surface-strong);
    transform: translateY(-1px);
    box-shadow: 0 14px 30px rgba(17, 74, 133, 0.14);
  }

  .sponge-language-switch svg {
    flex: 0 0 auto;
  }

  .deck-slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    align-items: center;
    padding: clamp(24px, 6vw, 72px);
    row-gap: clamp(20px, 3vh, 40px);
    transition:
      opacity 620ms cubic-bezier(0.65, 0, 0.35, 1),
      transform 620ms cubic-bezier(0.65, 0, 0.35, 1);
    opacity: 0;
    transform: translateY(48px);
    pointer-events: none;
  }

  .deck-slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    z-index: 2;
  }

  .deck-slide.is-past {
    opacity: 0;
    transform: translateY(-48px);
    z-index: 1;
  }

  .deck-slide.is-future {
    opacity: 0;
    transform: translateY(48px);
    z-index: 1;
  }

  .deck-slide-body {
    width: min(1180px, 100%);
    display: grid;
    justify-items: center;
    align-content: center;
    row-gap: clamp(36px, 6vh, 72px);
  }

  .sponge-intro-mark {
    position: absolute;
    inset: 50% auto auto 50%;
    width: min(720px, 70vw);
    opacity: 0.08;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .sponge-intro-stage {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    align-items: center;
    justify-items: center;
  }

  .sponge-full-name {
    grid-area: 1 / 1;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(10px, 2vw, 24px);
    align-items: baseline;
    justify-content: center;
    animation: sponge-fullname-out 420ms ease forwards;
    animation-delay: 2.3s;
  }

  .sponge-word {
    display: inline-flex;
    align-items: baseline;
    color: var(--text);
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: clamp(2rem, 5vw, 4.8rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(18px);
    animation: sponge-word-in 520ms ease forwards;
    animation-delay: calc(var(--word-index) * 240ms);
  }

  .sponge-lead {
    color: var(--primary);
  }

  .sponge-tail {
    color: var(--muted);
  }

  .sponge-acronym {
    grid-area: 1 / 1;
    margin: 0;
    color: var(--primary);
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: clamp(5.5rem, 17vw, 15rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: 0.06em;
    text-align: center;
    opacity: 0;
    transform: translateY(12px);
    animation: sponge-acronym-in 600ms ease forwards;
    animation-delay: 2.72s;
  }

  .sponge-entry {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(12px, 2vw, 20px);
    justify-content: center;
    max-width: min(980px, 100%);
    opacity: 0;
    transform: translateY(16px);
    animation: sponge-fade-up 600ms ease forwards;
    animation-delay: 3.35s;
  }

  .sponge-entry-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: clamp(12px, 1.4vw, 16px) clamp(22px, 2.4vw, 30px);
    border-radius: 999px;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .sponge-entry-link svg {
    flex-shrink: 0;
  }

  .sponge-entry-link.is-primary {
    background: var(--primary);
    color: #fff;
    border: 1px solid var(--primary);
    box-shadow: 0 12px 30px rgba(29, 105, 181, 0.28);
  }

  .sponge-entry-link.is-primary:hover {
    background: var(--primary-strong);
    border-color: var(--primary-strong);
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(17, 74, 133, 0.32);
  }

  .sponge-entry-link.is-outline {
    background: var(--surface);
    color: var(--primary);
    border: 1px solid color-mix(in srgb, var(--primary) 45%, transparent);
    backdrop-filter: blur(12px);
  }

  .sponge-entry-link.is-outline:hover {
    background: var(--surface-strong);
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .sponge-scroll-hint {
    --bounce-y: 6px;
    position: absolute;
    bottom: clamp(20px, 3.5vh, 40px);
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 0.82rem;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity 500ms ease, color 180ms ease;
  }

  .sponge-scroll-hint.up {
    --bounce-y: -6px;
    top: clamp(20px, 3.5vh, 40px);
    bottom: auto;
  }

  .sponge-deck.is-ready .sponge-scroll-hint {
    opacity: 1;
    visibility: visible;
    animation: sponge-bounce 1.8s ease-in-out 400ms infinite;
  }

  .sponge-deck.has-seen-intro .sponge-full-name,
  .sponge-deck.has-seen-intro .sponge-word,
  .sponge-deck.has-seen-intro .sponge-acronym,
  .sponge-deck.has-seen-intro .sponge-entry {
    animation: none;
  }

  .sponge-deck.has-seen-intro .sponge-full-name {
    opacity: 0;
    transform: translateY(-12px);
    visibility: hidden;
  }

  .sponge-deck.has-seen-intro .sponge-word,
  .sponge-deck.has-seen-intro .sponge-acronym,
  .sponge-deck.has-seen-intro .sponge-entry {
    opacity: 1;
    transform: none;
  }

  .sponge-scroll-hint:hover {
    color: var(--primary);
  }

  .sponge-scroll-hint svg {
    display: block;
  }

  .deck-overview {
    text-align: center;
    max-width: 860px;
  }

  .deck-context {
    max-width: 1080px;
    row-gap: clamp(28px, 5vh, 54px);
  }

  .deck-context-heading {
    display: grid;
    gap: 16px;
    justify-items: center;
    text-align: center;
  }

  .deck-context-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 24px);
    width: 100%;
  }

  .deck-context-item {
    min-height: 210px;
    padding: clamp(20px, 2.4vw, 30px);
    border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    box-shadow: 0 14px 36px rgba(17, 74, 133, 0.08);
    backdrop-filter: blur(12px);
  }

  .deck-context-item h3 {
    margin: 0 0 12px;
    color: var(--text);
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: clamp(1.08rem, 1.5vw, 1.3rem);
    line-height: 1.25;
  }

  .deck-context-item p {
    margin: 0;
    color: var(--muted);
    font-size: clamp(0.94rem, 1.05vw, 1rem);
    line-height: 1.7;
  }

  .deck-feature {
    max-width: 920px;
    justify-items: start;
    row-gap: clamp(18px, 3vh, 30px);
  }

  .deck-feature .deck-title,
  .deck-feature .deck-body {
    text-align: left;
  }

  .deck-feature .deck-body {
    max-width: 790px;
  }

  .deck-feature-points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: clamp(12px, 1.8vw, 18px);
    width: 100%;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .deck-feature-points.has-3-points {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .deck-feature-points.has-2-points {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 860px;
  }

  .deck-feature-points.has-4-points {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: 1120px;
  }

  .deck-feature-points li {
    min-height: 112px;
    padding: 18px;
    border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--text);
    font-size: clamp(0.92rem, 1vw, 1rem);
    line-height: 1.6;
    overflow-wrap: break-word;
    box-shadow: 0 12px 30px rgba(17, 74, 133, 0.07);
    backdrop-filter: blur(12px);
  }

  .deck-eyebrow {
    margin: 0;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: 0.92rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .deck-title {
    margin: 0;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: clamp(1.8rem, 4vw, 3rem);
