---
import SectionHeading from "../shared/SectionHeading.astro";
import { components } from "../../data/homepage";
---

<section class="section">
  <div class="container">
    <SectionHeading title="组成部分" />
    <div class="component-grid">
      {components.map((item) => (
        <article class="component-card panel">
          <h3>{item.name}</h3>
          <p>{item.description}</p>
          <a href={item.doi} target="_blank" rel="noreferrer">
            {item.citation}
          </a>
          <a class="component-doi" href={item.doi} target="_blank" rel="noreferrer">
            {item.doi.replace("https://doi.org/", "DOI: ")}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
