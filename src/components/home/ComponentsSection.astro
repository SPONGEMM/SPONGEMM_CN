---
import SectionHeading from "../shared/SectionHeading.astro";
import { components } from "../../data/homepage";

const {
  items = components,
  title = "如何引用",
  description = "如果 SPONGE 及相关工具支持了你的研究工作，请在论文中引用对应的软件或方法论文。"
} = Astro.props;
---

<section class="section" id="citation">
  <div class="container">
    <SectionHeading
      title={title}
      description={description}
    />
    <div class="component-grid">
      {items.map((item) => (
        <article class="component-card panel">
          <h3>{item.name}</h3>
          <p>{item.description}</p>
          <cite>{item.citation}</cite>
          <a class="component-doi" href={item.doi} target="_blank" rel="noreferrer">
            {item.doi.replace("https://doi.org/", "DOI: ")}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
