---
import { highlights } from "../../data/homepage";
import SectionHeading from "../shared/SectionHeading.astro";
---

<section class="section">
  <div class="container">
    <SectionHeading
      eyebrow="研究成果"
      title="代表性应用与论文精选"
      description="保留原首页中的成果脉络，并把重点条目重构为可视化卡片。"
    />
    <div class="highlight-grid">
      {highlights.map((item) => (
        <article class="highlight-card panel">
          <div class="highlight-media">
            {item.image ? (
              <img src={item.image} alt={item.alt} loading="lazy" />
            ) : (
              <div class="highlight-no-image">
                <p class="highlight-year">{item.year}</p>
                <h3>{item.title}</h3>
              </div>
            )}
          </div>
          <div class="highlight-body">
            <p class="highlight-year">{item.year}</p>
            <h3>{item.title}</h3>
            <a href={item.doi} target="_blank" rel="noreferrer">
              {item.doi.replace("https://doi.org/", "DOI: ")}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
