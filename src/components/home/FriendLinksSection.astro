---
import { friendLinks } from "../../data/homepage";
import SectionHeading from "../shared/SectionHeading.astro";

const {
  items = friendLinks,
  title = "友情链接"
} = Astro.props;
---

<section class="section" id="friend-links">
  <div class="container">
    <SectionHeading title={title} />
    <div class="friend-grid">
      {items.map((item) => (
        <a class="friend-card panel" href={item.href} target="_blank" rel="noreferrer">
          {item.image ? (
            <img src={item.image} alt={item.name} />
          ) : (
            <div class="friend-badge" aria-hidden="true">
              {item.name}
            </div>
          )}
          <div class="friend-body">
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <span>{item.href.replace("https://", "")}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
