---
import { hero } from "../../data/homepage";

const {
  item = hero,
  titleLines = ["SPONGE", "面向下一代分子科学的分子模拟软件"],
  image = "/assets/home/1ubq.jpg"
} = Astro.props;
---

<section class="hero section">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1>
        <span class="hero-accent">{titleLines[0]}</span>
        <span>{titleLines[1]}</span>
      </h1>
      <p class="hero-intro">{item.intro}</p>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <img class="hero-visual-image" src={image} alt="" loading="eager" />
    </div>
  </div>
</section>
